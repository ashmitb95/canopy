{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "baseUrl": ".",
    "paths": { "@/*": ["./webview/*"] }
  },
  "include": ["src", "scripts", "test"]
}
