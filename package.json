{
  "name": "agentdeck",
  "displayName": "AgentDeck",
  "description": "Chat with coding agents on your own subscriptions.",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "publisher": "ashmitb95",
  "engines": {
    "vscode": "^1.106.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:agentdeck.chatPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentdeck",
          "title": "AgentDeck",
          "icon": "media/agentdeck.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agentdeck-chat",
          "title": "AgentDeck",
          "icon": "media/agentdeck.svg"
        }
      ]
    },
    "views": {
      "agentdeck": [
        {
          "id": "agentdeck.sessions",
          "name": "AgentDeck",
          "type": "webview"
        }
      ],
      "agentdeck-chat": [
        {
          "type": "webview",
          "id": "agentdeck.chat",
          "name": "AgentDeck"
        }
      ]
    },
    "configuration": {
      "title": "AgentDeck",
      "properties": {
        "agentdeck.notifications.finished.level": {
          "type": "string",
          "enum": [
            "sound+popup",
            "sound",
            "popup",
            "off"
          ],
          "default": "sound+popup",
          "description": "When a chat finishes a turn."
        },
        "agentdeck.notifications.finished.sound": {
          "type": "string",
          "enum": [
            "Basso",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Hero"
        },
        "agentdeck.notifications.approval.level": {
          "type": "string",
          "enum": [
            "sound+popup",
            "sound",
            "popup",
            "off"
          ],
          "default": "sound+popup",
          "description": "When a chat needs an approval."
        },
        "agentdeck.notifications.approval.sound": {
          "type": "string",
          "enum": [
            "Basso",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Glass"
        },
        "agentdeck.notifications.question.level": {
          "type": "string",
          "enum": [
            "sound+popup",
            "sound",
            "popup",
            "off"
          ],
          "default": "sound+popup",
          "description": "When a chat asks a question."
        },
        "agentdeck.notifications.question.sound": {
          "type": "string",
          "enum": [
            "Basso",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Ping"
        },
        "agentdeck.notifications.failed.level": {
          "type": "string",
          "enum": [
            "sound+popup",
            "sound",
            "popup",
            "off"
          ],
          "default": "sound+popup",
          "description": "When a turn fails."
        },
        "agentdeck.notifications.failed.sound": {
          "type": "string",
          "enum": [
            "Basso",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Basso"
        },
        "agentdeck.notifications.volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "Sound volume (1 = system volume; macOS and Linux)."
        },
        "agentdeck.notifications.minDurationSeconds": {
          "type": "number",
          "minimum": 0,
          "default": 10,
          "description": "Only notify that a turn finished when it ran at least this long."
        },
        "agentdeck.notifications.muteWhenFocused": {
          "type": "boolean",
          "default": true,
          "description": "Stay quiet while VS Code is focused and the chat is visible."
        },
        "agentdeck.keepAwake": {
          "type": "boolean",
          "default": true,
          "description": "Keep the computer from sleeping while a chat is running (macOS and Linux)."
        },
        "agentdeck.customAgents": {
          "type": "array",
          "default": [],
          "markdownDescription": "More ACP agents: `{ \"id\": \"goose\", \"label\": \"Goose\", \"command\": \"goose\", \"args\": [\"acp\"], \"loginArgs\": [\"configure\"] }`. Reload the window after changing.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "loginArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "agentdeck.palette": {
          "type": "string",
          "enum": [
            "theme",
            "paper",
            "peach",
            "lilac",
            "sage",
            "sky"
          ],
          "enumItemLabels": [
            "VS Code theme only",
            "Paper",
            "Peach",
            "Lilac",
            "Sage",
            "Sky"
          ],
          "default": "paper",
          "description": "Brand and status colors for the chat, in light and dark to match your VS Code theme. Backgrounds, text, and borders always come from your theme. High-contrast themes keep their own colors."
        },
        "agentdeck.roster.lead": {
          "type": "string",
          "default": "claude",
          "description": "The agent that leads new group chats."
        },
        "agentdeck.roster.research": {
          "type": "string",
          "default": "",
          "description": "The agent that holds the research role in new group chats; empty for none."
        },
        "agentdeck.roster.implement": {
          "type": "string",
          "default": "codex",
          "description": "The agent that holds the implement role in new group chats; empty for none."
        },
        "agentdeck.roster.review": {
          "type": "string",
          "default": "grok",
          "description": "The agent that holds the review role in new group chats; empty for none."
        },
        "agentdeck.roster.enforce": {
          "type": "boolean",
          "default": true,
          "description": "Only the implement agent may edit code in group chats."
        },
        "agentdeck.roster.questionsTo": {
          "type": "string",
          "enum": [
            "lead",
            "user"
          ],
          "enumDescriptions": [
            "The lead answers a delegate's questions from the chat; you can change any answer.",
            "Every question from a delegate comes to you."
          ],
          "default": "lead",
          "description": "Who answers questions from delegates in new group chats."
        },
        "agentdeck.roster.verify": {
          "type": "string",
          "default": "",
          "description": "A command AgentDeck runs itself after the implement agent changes files, such as `pnpm test`."
        }
      }
    },
    "commands": [
      {
        "command": "agentdeck.newChat",
        "title": "New Chat in Editor",
        "category": "AgentDeck",
        "icon": "$(add)"
      },
      {
        "command": "agentdeck.sidebar.newChat",
        "title": "New Chat",
        "category": "AgentDeck",
        "icon": "$(add)"
      },
      {
        "command": "agentdeck.openInEditor",
        "title": "Open Chat in Editor",
        "category": "AgentDeck",
        "icon": "$(link-external)"
      },
      {
        "command": "agentdeck.manageProviders",
        "title": "Manage Providers",
        "category": "AgentDeck",
        "icon": "$(account)"
      },
      {
        "command": "agentdeck.openProviderConfig",
        "title": "Open Provider Config…",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.openSession",
        "title": "Open in Editor",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.openSessionInSidebar",
        "title": "Open in Sidebar",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.addToChat",
        "title": "Add to AgentDeck Chat",
        "category": "AgentDeck",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentdeck.forkSession",
        "title": "Fork Conversation",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.renameSession",
        "title": "Rename…",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.moveSessionToLane",
        "title": "Move to Lane…",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.setLaneGoal",
        "title": "Set Lane Goal…",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.openLanePlan",
        "title": "Open Lane Plan",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newLane",
        "title": "New Lane…",
        "category": "AgentDeck",
        "icon": "$(git-branch)"
      },
      {
        "command": "agentdeck.reviewLane",
        "title": "Review Lane Changes",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.laneIntoPrimary",
        "title": "Move to Primary Checkout",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.laneToWorktree",
        "title": "Move to Worktrees",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.handOff",
        "title": "Hand Off to…",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.testNotification",
        "title": "Test Notification",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.stopSession",
        "title": "Stop",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.deleteSession",
        "title": "Delete…",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newChat.claude",
        "title": "Claude",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newChat.codex",
        "title": "Codex",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newChat.grok",
        "title": "Grok",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newChat.cursor",
        "title": "Cursor",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newChat.opencode",
        "title": "OpenCode",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newChat.gemini",
        "title": "Gemini",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newChat.other",
        "title": "Other Agent…",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.newGroupChat",
        "title": "New Group Chat",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.openGroup",
        "title": "Open Group Chat",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.openLanes",
        "title": "Open Lanes",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.reviewGroup",
        "title": "Review Group Chat",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.openSetup",
        "title": "Open Setup",
        "category": "AgentDeck",
        "icon": "$(gear)"
      },
      {
        "command": "agentdeck.setLinearKey",
        "title": "Connect Linear (API key)",
        "category": "AgentDeck"
      },
      {
        "command": "agentdeck.clearLinearKey",
        "title": "Disconnect Linear",
        "category": "AgentDeck"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "agentdeck.openLanePlan",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'lane'",
          "group": "1_open@1"
        },
        {
          "command": "agentdeck.reviewLane",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'lane'",
          "group": "1_open@2"
        },
        {
          "command": "agentdeck.setLaneGoal",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'lane'",
          "group": "2_edit@1"
        },
        {
          "command": "agentdeck.laneIntoPrimary",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'lane'",
          "group": "3_move@1"
        },
        {
          "command": "agentdeck.laneToWorktree",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'lane'",
          "group": "3_move@2"
        },
        {
          "command": "agentdeck.openSessionInSidebar",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "1_open@1"
        },
        {
          "command": "agentdeck.openSession",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "1_open@2"
        },
        {
          "command": "agentdeck.handOff",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "1_open@3"
        },
        {
          "command": "agentdeck.forkSession",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "1_open@4"
        },
        {
          "command": "agentdeck.renameSession",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "2_edit@1"
        },
        {
          "command": "agentdeck.moveSessionToLane",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "2_edit@2"
        },
        {
          "command": "agentdeck.stopSession",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "2_edit@3"
        },
        {
          "command": "agentdeck.deleteSession",
          "when": "webviewId == 'agentdeck.sessions' && webviewSection == 'session'",
          "group": "3_delete@1"
        }
      ],
      "view/title": [
        {
          "command": "agentdeck.openSetup",
          "when": "view == agentdeck.sessions",
          "group": "navigation@9"
        },
        {
          "submenu": "agentdeck.newChatMenu.chat",
          "when": "view == agentdeck.chat",
          "group": "navigation@1"
        },
        {
          "command": "agentdeck.openInEditor",
          "when": "view == agentdeck.chat",
          "group": "navigation@2"
        },
        {
          "command": "agentdeck.manageProviders",
          "when": "view == agentdeck.chat",
          "group": "navigation@3"
        },
        {
          "submenu": "agentdeck.newChatMenu.sessions",
          "when": "view == agentdeck.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentdeck.newLane",
          "when": "view == agentdeck.sessions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [],
      "commandPalette": [
        {
          "command": "agentdeck.openSession",
          "when": "false"
        },
        {
          "command": "agentdeck.openSessionInSidebar",
          "when": "false"
        },
        {
          "command": "agentdeck.renameSession",
          "when": "false"
        },
        {
          "command": "agentdeck.moveSessionToLane",
          "when": "false"
        },
        {
          "command": "agentdeck.setLaneGoal",
          "when": "false"
        },
        {
          "command": "agentdeck.openLanePlan",
          "when": "false"
        },
        {
          "command": "agentdeck.reviewLane",
          "when": "false"
        },
        {
          "command": "agentdeck.laneIntoPrimary",
          "when": "false"
        },
        {
          "command": "agentdeck.laneToWorktree",
          "when": "false"
        },
        {
          "command": "agentdeck.stopSession",
          "when": "false"
        },
        {
          "command": "agentdeck.deleteSession",
          "when": "false"
        },
        {
          "command": "agentdeck.newChat.claude",
          "when": "false"
        },
        {
          "command": "agentdeck.newChat.codex",
          "when": "false"
        },
        {
          "command": "agentdeck.newChat.grok",
          "when": "false"
        },
        {
          "command": "agentdeck.newChat.cursor",
          "when": "false"
        },
        {
          "command": "agentdeck.newChat.opencode",
          "when": "false"
        },
        {
          "command": "agentdeck.newChat.gemini",
          "when": "false"
        },
        {
          "command": "agentdeck.newChat.other",
          "when": "false"
        },
        {
          "command": "agentdeck.openGroup",
          "when": "false"
        },
        {
          "command": "agentdeck.reviewGroup",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "agentdeck.addToChat",
          "when": "resourceScheme == file",
          "group": "agentdeck@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "agentdeck.addToChat",
          "when": "resourceScheme == file",
          "group": "agentdeck@1"
        }
      ],
      "agentdeck.newChatMenu.sessions": [
        {
          "command": "agentdeck.newChat.claude",
          "when": "agentdeck.installed.claude",
          "group": "1_providers@0"
        },
        {
          "command": "agentdeck.newChat.codex",
          "when": "agentdeck.installed.codex",
          "group": "1_providers@1"
        },
        {
          "command": "agentdeck.newChat.grok",
          "when": "agentdeck.installed.grok",
          "group": "1_providers@2"
        },
        {
          "command": "agentdeck.newChat.cursor",
          "when": "agentdeck.installed.cursor",
          "group": "1_providers@3"
        },
        {
          "command": "agentdeck.newChat.opencode",
          "when": "agentdeck.installed.opencode",
          "group": "1_providers@4"
        },
        {
          "command": "agentdeck.newChat.gemini",
          "when": "agentdeck.installed.gemini",
          "group": "1_providers@5"
        },
        {
          "command": "agentdeck.newChat.other",
          "group": "2_more@1"
        }
      ],
      "agentdeck.newChatMenu.chat": [
        {
          "command": "agentdeck.newChat.claude",
          "when": "agentdeck.installed.claude",
          "group": "1_providers@0"
        },
        {
          "command": "agentdeck.newChat.codex",
          "when": "agentdeck.installed.codex",
          "group": "1_providers@1"
        },
        {
          "command": "agentdeck.newChat.grok",
          "when": "agentdeck.installed.grok",
          "group": "1_providers@2"
        },
        {
          "command": "agentdeck.newChat.cursor",
          "when": "agentdeck.installed.cursor",
          "group": "1_providers@3"
        },
        {
          "command": "agentdeck.newChat.opencode",
          "when": "agentdeck.installed.opencode",
          "group": "1_providers@4"
        },
        {
          "command": "agentdeck.newChat.gemini",
          "when": "agentdeck.installed.gemini",
          "group": "1_providers@5"
        },
        {
          "command": "agentdeck.newChat.other",
          "group": "2_more@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentdeck.addToChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      }
    ],
    "submenus": [
      {
        "id": "agentdeck.newChatMenu.sessions",
        "label": "New Chat",
        "icon": "$(add)"
      },
      {
        "id": "agentdeck.newChatMenu.chat",
        "label": "New Chat",
        "icon": "$(add)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build:preview": "node esbuild.mjs --preview",
    "screenshot": "node scripts/screenshot.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "package": "pnpm build && vsce package --no-dependencies --skip-license --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "ai": "7.0.154",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "katex": "0.16.27",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
