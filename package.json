{
  "name": "agentdeck",
  "displayName": "AgentDeck",
  "description": "Chat with coding agents on your own subscriptions.",
  "version": "0.0.1",
  "private": true,
  "publisher": "ashmitb95",
  "engines": {
    "vscode": "1.95.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agentdeck.newClaudeChat",
        "title": "New Claude Chat",
        "category": "AgentDeck"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview",
    "test": "vitest run",
    "package": "pnpm build && vsce package --no-dependencies --skip-license --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "@streamdown/code": "2.0.0",
    "ai": "7.0.154",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
